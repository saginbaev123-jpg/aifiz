# Copy this file to .env for Windows/local deployment.
APP_MODE=production
ALLOW_USER_API_KEY=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional database path. If omitted, ./data/ai_physics_kz.db is used.
# AI_PHYSICS_DB=data/ai_physics_kz.db

# ЖИ сұрауларының желілік күту уақыты
AI_REQUEST_TIMEOUT_SECONDS=180
AI_IMAGE_TIMEOUT_SECONDS=240
AI_MAX_RETRIES=2
